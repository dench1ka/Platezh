<Window x:Class="Platezh.Views.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Platezh.Views"
        mc:Ignorable="d"
        Title="Окно редактирования" 
        Height="600" 
        Width="650"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        MinWidth="650"
        Icon="/Assets/Icons/logo.ico"
        MinHeight="550">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF0D47A1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="Padding" Value="0,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="320"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F9FF" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" 
                Background="White" 
                CornerRadius="5" 
                BorderBrush="#FFE0E0E0" 
                BorderThickness="1" 
                Padding="15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование данных" 
                             FontWeight="Bold" 
                             Foreground="#FF1976D2" 
                             FontSize="16" 
                             Margin="0,0,0,10"/>

                    <Label x:Name="SectionName" FontWeight="Bold" FontSize="14"/>
                    <Label x:Name="NameItem" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                    <StackPanel HorizontalAlignment="Left">
                        <Label Content="ID"/>
                        <TextBox x:Name="IdBox"  IsReadOnly="True" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Left">
                        <Label Content="Название" Margin="30,0,0,0"/>
                        <TextBox x:Name="NameBox"/>
                    </StackPanel>

                    <StackPanel  x:Name="MaterialsInputPanel">
                        <Label Content="Количество" Margin="0,0,0,0"/>
                        <TextBox HorizontalAlignment="Left" x:Name="StockBox"/>

                        <Label Content="Цена без НДС" Margin="0,0,0,0"/>
                        <TextBox HorizontalAlignment="Left" x:Name="PriceWithoutNdsBox"/>

                        <StackPanel  Orientation="Horizontal">
                            <Label Content="НДС" Width="255" Margin="0,0,0,0"/>
                            <Label Content="%/BYN" FontSize="12" Width="60"/>
                        </StackPanel>
                        <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="NdsBox" Width="244" Margin="0,0,0,0"/>
                            <ComboBox x:Name="NdsComboBox" Width="60" Margin="10,0,0,0" SelectionChanged="NdsChanged">
                                <ComboBoxItem Content="%"/>
                                <ComboBoxItem Content="BYN"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Left" x:Name="ServicesInputPanel">
                        <Label Content="Тариф" Margin="0,0,0,0"/>
                        <TextBox x:Name="TarifBox"/>

                        <Label Content="Стоимость доп. материалов" Margin="0,0,0,0"/>
                        <TextBox x:Name="AdditionalMaterialsPriceBox"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Left">
                        <Label Content="Итоговая стоимость" Margin="0,0,0,0"/>
                        <TextBox x:Name="TotalPriceBox" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="1" 
                Background="White" 
                CornerRadius="5" 
                BorderBrush="#FFE0E0E0" 
                BorderThickness="1" 
                Margin="10,0,0,0"
                Padding="15"
                Width="200">
            <StackPanel>
                <TextBlock Text="Действия" 
                         FontWeight="Bold" 
                         Foreground="#FF1976D2" 
                         FontSize="16" 
                         Margin="0,0,0,15" 
                         HorizontalAlignment="Center"/>

                <ComboBox x:Name="CalcChoice" Margin="0,0,0,15">
                    <ComboBoxItem Content="Итоговую стоимость"/>
                    <ComboBoxItem Content="Стоимость без НДС"/>
                </ComboBox>

                <Button x:Name="CalcilationBtn" 
                      Content="Перерасчитать" 
                      Height="38" 
                      Click="CalcilationBtn_Click" 
                      Margin="0,0,0,10"/>

                <Button x:Name="SaveBtn" 
                      Content="Сохранить" 
                      Height="38" 
                      Click="SaveChanges_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>