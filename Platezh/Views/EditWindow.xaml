<Window x:Class="Platezh.Views.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Окно редактирования" 
        Height="600" 
        Width="650"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        MinWidth="650"
        MinHeight="550"
        Icon="/Assets/Icons/logo.ico"
        Background="#FFF5F9FF">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,2,0,12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Foreground" Value="#FF424242"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Редактирование данных" FontWeight="Bold" Foreground="#FF1976D2" FontSize="18" Margin="0,0,0,15"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Label x:Name="SectionName" Content="Режим:" Foreground="Gray"/>
                        <Label x:Name="NameItem" Content="Элемент" FontSize="16" Foreground="#FF1976D2"/>
                    </StackPanel>

                    <Separator Margin="0,5,0,15"/>

                    <Label Content="ID записи:"/>
                    <TextBox x:Name="IdBox" IsReadOnly="True" Background="#FFF0F0F0" Foreground="Gray" Width="300" HorizontalAlignment="Left"/>

                    <Label Content="Название:"/>
                    <TextBox x:Name="NameBox" Width="300" HorizontalAlignment="Left"/>

                    <CheckBox x:Name="IsActiveCheck" Content="Запись активна (доступна в системе)" 
                              FontWeight="SemiBold" Margin="0,5,0,20" Foreground="#FF1976D2" VerticalContentAlignment="Center"/>

                    <StackPanel x:Name="MaterialsInputPanel">
                        <Label Content="Количество на складе:"/>
                        <TextBox x:Name="StockBox" Width="300" HorizontalAlignment="Left"/>

                        <Label Content="Цена без НДС:"/>
                        <TextBox x:Name="PriceWithoutNdsBox" Width="300" HorizontalAlignment="Left"/>

                        <Label Content="НДС в %:"/>
                        <TextBox x:Name="NdsBox" Width="100" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel x:Name="ServicesInputPanel">
                        <Label Content="Тариф (базовая цена):"/>
                        <TextBox x:Name="TarifBox" Width="300" HorizontalAlignment="Left"/>

                        <Label Content="Стоимость доп. материалов:"/>
                        <TextBox x:Name="AdditionalMaterialsPriceBox" Width="300" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="1" Margin="15,0,0,0">
            <Border Background="White" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="15">
                <StackPanel>
                    <TextBlock Text="Действия" FontWeight="Bold" Foreground="#FF1976D2" FontSize="16" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <Button x:Name="SaveBtn" Content="Сохранить" Height="45" Background="#FF43A047" Click="SaveChanges_Click"/>

                    <TextBlock Text="Расчет итоговой суммы произойдет автоматически при сохранении." 
                               TextWrapping="Wrap" FontSize="11" Foreground="Gray" Margin="5,15,5,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button Content="Закрыть" Height="35" Margin="0,10,0,0" Background="#FF757575" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>