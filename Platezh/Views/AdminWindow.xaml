<Window x:Class="Platezh.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Администратор"
        Height="830"
        Width="1550"
        WindowState="Maximized"
        Icon="/Assets/Icons/logo.ico"
        FontSize="14">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF0D47A1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF5F5F5"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFEEEEEE"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFEEEEEE"/>
            <Setter Property="ColumnHeaderHeight" Value="35"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F9FF" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,10,0,0">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10" Width="1235">

                <StackPanel Width="300" Margin="0,0,20,0">
                    <Label Content="Поиск по логину"/>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <Label Content="Пользователи" FontSize="20" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="270,0,0,0" HorizontalAlignment="Center" Width="Auto"/>

            </StackPanel>

            <Border CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White">
                <DataGrid x:Name="UsersGrid">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding id}" Width="60"/>
                        <DataGridTextColumn Header="Логин" Binding="{Binding login}" Width="*"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding roleName}" Width="150"/>
                        <DataGridTextColumn Header="Активен" Binding="{Binding isActive}" Width="100"/>
                        <DataGridTextColumn Header="Дата создания" Binding="{Binding createdAt}" Width="200"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>

        <Border Grid.Column="1"
                Background="White"
                CornerRadius="5"
                BorderBrush="#FFE0E0E0"
                BorderThickness="1"
                Margin="10,10,0,10"
                Padding="12">

            <StackPanel>
                <TextBlock Text="Управление пользователем"
                           FontWeight="Bold"
                           FontSize="16"
                           Foreground="#FF1976D2"
                           Margin="0,0,0,10"/>

                <StackPanel Margin="0,15,0,0">

                    <Button Content="Добавить пользователя"
                        Height="38"
                        Margin="0,8,0,0"
                        Click="AddUser_Click"/>

                    <Button Content="Редактировать пользователя"
                        Height="38"
                        Margin="0,8,0,0"
                        Click="EditUser_Click"/>


                    <Button Content="Удалить пользователя"
                            Height="38"
                            Background="#FFD32F2F"
                            BorderBrush="#FFB71C1C"
                            Margin="0,8,0,0"
                            Click="DeleteUser_Click"/>

                    <Button Content="Назад"
                            Height="38"
                            Margin="0,15,0,0"
                            Click="Back_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>