<Window x:Class="Platezh.Views.Casher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кассир"
        Width="1550"
        Height="830"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Closing="Window_Closing"
        Icon="/Assets/Icons/logo.ico"
        FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF0D47A1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF5F5F5"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFEEEEEE"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFEEEEEE"/>
            <Setter Property="ColumnHeaderHeight" Value="35"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#FFE3F2FD"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="Margin" Value="2"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F9FF">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="10">
            <Border CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White" 
                    Margin="0,10,0,0" Padding="8">
                <StackPanel>
                    <TextBlock Text="Выбранные элементы" FontWeight="Bold" Foreground="#FF1976D2" 
                               FontSize="16" Margin="0,0,0,8"/>
                    <ListBox x:Name="SelectedItemsListBox" Height="350" KeyDown="SelectedItemsListBox_KeyDown"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Vertical" Margin="0,15,0,0">
                <Button x:Name="deleteRecord" Height="40" Content="Удалить" Click="Deletebtn_Click"/>
                <Button x:Name="addNewRecord" Height="40" Content="Добавить" Margin="0,10,0,0" Click="Addbtnclicked"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="860">
                <StackPanel Width="380" Margin="0,10,15,10">
                    <Label Content="Поиск" FontSize="16"/>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <Label x:Name="NameOfCategory" Content="Материалы" FontSize="20" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="120,0,0,0" Width="232"/>
            </StackPanel>
            
            <Border Grid.Row="1" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White">
                <DataGrid x:Name="Materials" Visibility="Visible" MouseDoubleClick="Grid_Click"/>
            </Border>
            <DataGrid x:Name="Services" Grid.Row="1" Visibility="Hidden" MouseDoubleClick="Grid_Click"/>
            <Button x:Name="TypeCategoriesbtn" Grid.Row="2" Content="Переключить на услуги" Height="40" 
                    Click="TypeCategories_Click" HorizontalAlignment="Center" Margin="0,10,0,0" Width="240"/>
        </Grid>
        <StackPanel Grid.Column="2" Margin="10">
            <Border Background="White" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="12" Margin="0,10,0,10">
                <StackPanel>
                    <TextBlock Text="Информация о договоре" FontWeight="Bold" Foreground="#FF1976D2" 
                               FontSize="16" Margin="0,0,0,10"/>

                    <Label Content="Номер договора:"/>
                    <TextBox x:Name="ContractNumberBox"/>
                    <Label Content="ФИО клиента:"/>
                    <TextBox x:Name="ClientNameBox"/>
                    <Label Content="Серия паспорта:"/>
                    <TextBox x:Name="PassportNumberBox"/>
                    <Label Content="Кем выдан:"/>
                    <TextBox x:Name="IssuedByBox"/>
                    <Label Content="Дата выдачи:"/>
                    <DatePicker x:Name="DateIssueBox"/>
                    <Label Content="Адрес клиента:"/>
                    <TextBox x:Name="AddresBox"/>
                </StackPanel>
            </Border>

            <StackPanel Margin="0,5,0,0">
                <Button x:Name="generateContract" Height="38" Content="Сформировать договор" Click="GenerateContract_Click"/>
                <Button x:Name="openContract" Height="38" Content="Посмотреть договора" Click="ShowContracts"/>
                <Button Height="38" Content="Выбрать папку" Click="SelectFolderButton_Click"/>
                <Button Content="Назад" Height="38" Click="Button_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>