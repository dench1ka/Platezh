<Window x:Class="Platezh.Views.Casher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кассир" Width="1550" Height="830" WindowState="Maximized"
        Closing="Window_Closing" Icon="/Assets/Icons/logo.ico" FontSize="14">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F9FF" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel Width="300" Margin="0,0,20,0">
                    <Label Content="Поиск"/>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BtnClients" Content="Клиенты" Width="120" Click="ViewSwitch_Click"/>
                    <Button x:Name="BtnMaterials" Content="Материалы" Width="140" Click="ViewSwitch_Click"/>
                    <Button x:Name="BtnServices" Content="Услуги" Width="120" Click="ViewSwitch_Click"/>
                </StackPanel>
            </StackPanel>

            <Label Grid.Row="1" x:Name="CurrentTableTitle" Content="Материалы" FontSize="20" FontWeight="Bold"/>
            <Border Grid.Row="2" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White">
                <DataGrid x:Name="MainGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  IsReadOnly="True" 
                  SelectionChanged="MainGrid_SelectionChanged"
                  MouseDoubleClick="Grid_Click">
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="White" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Margin="10,10,0,10" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Выбранные элементы" FontWeight="Bold" Foreground="#FF1976D2" FontSize="16" Margin="0,0,0,10"/>
                    <ListBox x:Name="SelectedItemsListBox" Height="180" KeyDown="SelectedItemsListBox_KeyDown"/>

                    <UniformGrid Columns="2" Margin="0,8,0,15">
                        <Button x:Name="addNewRecord" Content="В список" Click="Addbtnclicked"/>
                        <Button x:Name="deleteRecord" Content="Убрать" Click="Deletebtn_Click" Background="#FFD32F2F"/>
                    </UniformGrid>

                    <Separator Margin="0,5,0,15"/>
                    <TextBlock Text="Данные клиента" FontWeight="Bold" Foreground="#FF1976D2" FontSize="16" Margin="0,0,0,10"/>

                    <Label Content="Выберите из базы (опционально):"/>
                    <ComboBox x:Name="ClientSelectBox" DisplayMemberPath="FullName" SelectionChanged="ClientSelectBox_SelectionChanged" Margin="0,0,0,10"/>

                    <Label Content="Номер договора:"/>
                    <TextBox x:Name="ContractNumberBox"/>

                    <Label Content="ФИО клиента:"/>
                    <TextBox x:Name="ClientNameBox"/>

                    <Label Content="Паспортные данные:"/>
                    <TextBox x:Name="PassportDataBox"/>
                    <Label Content="Адрес клиента:"/>
                    <TextBox x:Name="AddressBox"/>
                    <Button x:Name="SaveClientBtn" Content="Обновить/Сохранить клиента" Click="SaveClient_Click" Background="#FF43A047"/>

                    <Separator Margin="0,15"/>
                    <Button x:Name="generateContract" Height="45" Content="Сформировать договор" Click="GenerateContract_Click" FontWeight="Bold"/>
                    <Button Content="Назад" Click="Button_Click" Background="#FF757575"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>