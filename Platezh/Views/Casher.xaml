<Window x:Class="Platezh.Views.Casher"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кассир" Width="1550" Height="830" WindowState="Maximized"
        Closing="Window_Closing" Icon="/Assets/Icons/logo.ico" FontSize="14">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F9FF" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel Width="300" Margin="0,0,20,0">
                    <Label Content="Поиск"/>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BtnClients" Content="Клиенты" Width="120" Click="ViewSwitch_Click"/>
                    <Button x:Name="BtnMaterials" Content="Материалы" Width="140" Click="ViewSwitch_Click"/>
                    <Button x:Name="BtnServices" Content="Услуги" Width="120" Click="ViewSwitch_Click"/>
                </StackPanel>
            </StackPanel>

            <Label Grid.Row="1" x:Name="CurrentTableTitle" Content="Материалы" FontSize="20" FontWeight="Bold"/>

            <Border Grid.Row="2" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White">
                <DataGrid x:Name="MainGrid" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          SelectionChanged="MainGrid_SelectionChanged"
                          MouseDoubleClick="Grid_Click">
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="White" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Margin="10,10,0,10" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <StackPanel x:Name="BasketPanel">
                        <TextBlock Text="Выбранные элементы" FontWeight="Bold" Foreground="#FF1976D2" FontSize="16" Margin="0,0,0,10"/>
                        <ListBox x:Name="SelectedItemsListBox" Height="180" KeyDown="SelectedItemsListBox_KeyDown"/>

                        <UniformGrid Columns="2" Margin="0,8,0,15">
                            <Button x:Name="addNewRecord" Content="В список" Click="Addbtnclicked"/>
                            <Button x:Name="deleteRecord" Content="Убрать" Click="Deletebtn_Click" Background="#FFD32F2F"/>
                        </UniformGrid>

                        <Separator Margin="0,5,0,15"/>
                        <TextBlock Text="Оформление договора" FontWeight="Bold" Foreground="#FF1976D2" FontSize="16" Margin="0,0,0,10"/>

                        <Label Content="Номер договора (если пусто - автогенерация):"/>
                        <TextBox x:Name="ContractNumberBox" Margin="0,0,0,5"/>

                        <Label Content="Выберите клиента из базы:"/>
                        <ComboBox x:Name="ClientSelectBox" 
                                  DisplayMemberPath="FullName" 
                                  SelectedValuePath="id"
                                  IsEditable="True"
                                  StaysOpenOnEdit="True"
                                  TextSearch.TextPath="FullName"
                                  Margin="0,3,0,15"/>

                        <Button x:Name="generateContract" Height="45" Content="Сформировать договор" Click="GenerateContract_Click" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel x:Name="ClientFormPanel" Visibility="Collapsed">
                        <TextBlock Text="Данные клиента" FontWeight="Bold" Foreground="#FF1976D2" FontSize="16" Margin="0,0,0,10"/>

                        <Label Content="Фамилия:"/>
                        <TextBox x:Name="SurnameBox" Margin="0,0,0,5"/>

                        <Label Content="Имя:"/>
                        <TextBox x:Name="NameBox" Margin="0,0,0,5"/>

                        <Label Content="Отчество:"/>
                        <TextBox x:Name="FatherNameBox" Margin="0,0,0,5"/>

                        <Label Content="Номер паспорта:"/>
                        <TextBox x:Name="PassportDataBox" Margin="0,0,0,5"/>

                        <Label Content="Кем выдан:"/>
                        <TextBox x:Name="IssuedByBox" Margin="0,0,0,5"/>

                        <Label Content="Адрес проживания:"/>
                        <TextBox x:Name="AddressBox" Margin="0,0,0,5"/>

                        <Label Content="Дата выдачи"/>
                        <DatePicker x:Name="DateIssued"/>
                        
                        <Button x:Name="SaveClientBtn" Content="Сохранить клиента" Click="SaveClient_Click" Background="#FF43A047" Margin="0,15,0,0" Height="40" FontWeight="Bold"/>
                        <Button x:Name="EditClientBtn" Content="Редактироваить клиента" Click="EditClient_Click" Background="#FF1976D2" Margin="0,15,0,0" Height="40" FontWeight="Bold"/>
                        <Button x:Name="DeleteClientBtn" Content="Удалить клиента" Click="DeleteClientBtn_Click" Background="#FFD32F2F" Margin="0,15,0,0" Height="40" FontWeight="Bold"/>
                    </StackPanel>

                    <Separator Margin="0,15"/>
                    <Button Content="Назад" Click="Button_Click" Background="#FF757575"/>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>