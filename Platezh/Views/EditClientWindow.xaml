<Window x:Class="Platezh.Views.EditClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование клиента" Height="400" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Фамилия:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="SurnameBox" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Имя:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Отчество:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="FatherNameBox" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <TextBlock Text="№ Паспорта:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="PassportDataBox" Grid.Row="3" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Кем выдан:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="IssuedByBox" Grid.Row="4" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Дата выдачи:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <DatePicker x:Name="DateIssued" Grid.Row="5" Grid.Column="1" Margin="5"/>

        <TextBlock Text="Адрес:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <TextBox x:Name="AddressBox" Grid.Row="6" Grid.Column="1" Margin="5"/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="80" Margin="5" Background="#FF43A047" Click="SaveBtn_Click"/>
            <Button Content="Отмена" Width="80" Margin="5" Click="CancelBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>