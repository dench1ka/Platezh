<Window x:Class="Platezh.Views.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Width="800"
        Height="652"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Icons/logo.ico"
        Background="#FFF5F9FF">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF0D47A1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White" 
                CornerRadius="5" 
                BorderBrush="#FFE0E0E0" 
                BorderThickness="1"
                Width="400"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="20">
            <StackPanel>
                <TextBlock Text="Регистрация" 
                           FontWeight="Bold" 
                           Foreground="#FF1976D2" 
                           FontSize="20" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Label Content="Введите логин"/>
                <TextBox x:Name="txtLogin"/>

                <Label Content="Введите пароль" Margin="0,10,0,0"/>
                <PasswordBox x:Name="txtPassword"/>

                <Label Content="Выберите роль:" Margin="0,10,0,0"/>
                <ComboBox x:Name="cmbRole">
                </ComboBox>

                <Button Content="Зарегистрировать" 
                        Height="38"
                        Click="Button_Click"/>
                <Button Content="Назад" 
                        Height="38"
                        Click="Button_Click_1"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>