<Window x:Class="Platezh.Views.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Platezh - Регистрация"
        Width="800"
        Height="600"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/Icons/logo.ico"
        Background="#FFF5F9FF"
        
        UseLayoutRounding="True" 
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White" 
                CornerRadius="8" 
                BorderBrush="#FFE0E0E0" 
                BorderThickness="1"
                Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="30"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="1" Color="#FFCCCCCC" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Новый пользователь" 
                           FontWeight="Bold" 
                           Foreground="#FF1976D2" 
                           FontSize="22" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"
                           TextOptions.TextHintingMode="Fixed"/>
                <Label Content="Логин"/>
                <TextBox x:Name="txtLogin"/>

                <Label Content="Пароль"/>
                <PasswordBox x:Name="txtPassword"/>

                <Label Content="Роль в системе"/>
                <ComboBox x:Name="cmbRole" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,25" SnapsToDevicePixels="True"/>

                <Button Content="Зарегистрировать" 
                        Height="40"
                        Background="#FF43A047"
                        Click="Button_Click"
                        FontSize="15"/>

                <Button Content="Назад" 
                        Height="35"
                        Margin="0,10,0,0"
                        Background="#FF757575"
                        Click="Button_Click_1"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>