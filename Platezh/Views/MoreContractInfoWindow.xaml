<Window x:Class="Platezh.Views.MoreContractInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация" Width="1550" Height="830" WindowState="Maximized"
        Closing="Window_Closing" Icon="/Assets/Icons/logo.ico" FontSize="14">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F9FF" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,10,10,15">
            <Label x:Name="LabelInfo1" Content="Информация 1: данные из БД" FontWeight="Bold" FontSize="16"/>
            <Label x:Name="LabelInfo2" Content="Информация 2: дополнительные сведения" FontSize="14" Foreground="#FF555555"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White" Margin="5">
            <DataGrid x:Name="MainGrid" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True" 
                      SelectionChanged="MainGrid_SelectionChanged"
                      MouseDoubleClick="Grid_Click">
            </DataGrid>
        </Border>
    </Grid>
</Window>