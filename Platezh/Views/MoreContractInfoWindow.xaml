<Window x:Class="Platezh.Views.MoreContractInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Информация" Width="1550" Height="830" WindowState="Maximized"
        Icon="/Assets/Icons/logo.ico" FontSize="14">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F9FF" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="10,10,10,15">
            <Label x:Name="LabelNumberContract" Content="Номер договора" FontWeight="Bold" FontSize="16"/>
            <Label x:Name="LabelFullName" Content="ФИО клиента" FontWeight="Bold" FontSize="16"/>
            <Label x:Name="LabelUserName" Content="Логин" FontWeight="Bold" FontSize="16"/>
            <Label x:Name="LabelTotalPrice" Content="Итоговая стоимость" FontWeight="Bold" FontSize="16"/>
            <Label x:Name="LabelStatus" Content="Статус" FontWeight="Bold" FontSize="16"/>
            <Label x:Name="LabelContractDate" Content="Дата договора" FontWeight="Bold" FontSize="16"/>
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White" Margin="5">
            <DataGrid x:Name="MainGrid" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"/>
        </Border>
    </Grid>
</Window>