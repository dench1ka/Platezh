<Window x:Class="Platezh.Views.MoreContractInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детальная информация о договоре" 
        Width="1550" Height="830" 
        WindowState="Maximized"
        Icon="/Assets/Icons/logo.ico" 
        FontSize="14"
        Background="#FFF5F9FF">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="Label">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,-5"/>
        </Style>

        <Style x:Key="ValueLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#FF1976D2"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Карточка договора" FontSize="20" FontWeight="Bold" Foreground="#FF424242" Margin="0,0,0,20"/>

                <UniformGrid Columns="3">
                    <StackPanel>
                        <Label Content="Номер договора:" Style="{StaticResource HeaderLabel}"/>
                        <Label x:Name="LabelNumberContract" Content="№00000" Style="{StaticResource ValueLabel}"/>

                        <Label Content="Дата договора:" Style="{StaticResource HeaderLabel}"/>
                        <Label x:Name="LabelContractDate" Content="01.01.2024" Style="{StaticResource ValueLabel}"/>
                    </StackPanel>

                    <StackPanel>
                        <Label Content="Клиент:" Style="{StaticResource HeaderLabel}"/>
                        <Label x:Name="LabelFullName" Content="Иванов Иван Иванович" Style="{StaticResource ValueLabel}"/>

                        <Label Content="Статус:" Style="{StaticResource HeaderLabel}"/>
                        <Label x:Name="LabelStatus" Content="Активен" Style="{StaticResource ValueLabel}"/>
                    </StackPanel>

                    <StackPanel>
                        <Label Content="Сотрудник (логин):" Style="{StaticResource HeaderLabel}"/>
                        <Label x:Name="LabelUserName" Content="admin_01" Style="{StaticResource ValueLabel}"/>

                        <Label Content="Итоговая стоимость:" Style="{StaticResource HeaderLabel}"/>
                        <Label x:Name="LabelTotalPrice" Content="0.00 руб." Foreground="#FF43A047" Style="{StaticResource ValueLabel}"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White">
            <DataGrid x:Name="MainGrid" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      BorderThickness="0"
                      RowHeight="35"
                      ColumnHeaderHeight="40"
                      AlternatingRowBackground="#FFF9FCFF"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
                    </Style>
                </DataGrid.Resources>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Вернуться к списку" Width="200" Height="40" Click="ButtonBack_Click" Background="#FF757575"/>
        </StackPanel>
    </Grid>
</Window>