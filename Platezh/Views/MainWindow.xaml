<Window x:Class="Platezh.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Platezh - Авторизация" 
        Width="800" 
        Height="550"
        FontSize="14"
        WindowStartupLocation="CenterScreen"
        Icon="../Assets/Icons/logo.ico"
        Background="#FFF5F9FF"
        
        UseLayoutRounding="True" 
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF0D47A1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White" 
                CornerRadius="8" 
                BorderBrush="#FFE0E0E0" 
                BorderThickness="1"
                Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="30"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="1" Color="#FFCCCCCC" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Авторизация" 
                           FontWeight="Bold" 
                           Foreground="#FF1976D2" 
                           FontSize="24" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"
                           TextOptions.TextHintingMode="Fixed"/>
                <Label Content="Логин" Margin="0,0,0,2"/>
                <TextBox x:Name="loginTextBox"/>

                <Label Content="Пароль"/>
                <Grid>
                    <PasswordBox x:Name="passwordBox"/>
                    <TextBox x:Name="passwordTextBox" Visibility="Collapsed"/>
                    <Button Content="👁️" 
                            Width="30" 
                            Height="28" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Margin="0,0,2,0"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Foreground="#FF424242"
                            Cursor="Hand"
                            Click="TogglePasswordVisibility">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FF1976D2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Label Content="Роль"/>
                <ComboBox x:Name="Role" Height="32" VerticalContentAlignment="Center"/>

                <Button Content="Войти" 
                        Margin="0,30,0,0" 
                        Height="40"
                        FontSize="16"
                        Click="Login"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>