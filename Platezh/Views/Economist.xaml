<Window x:Class="Platezh.Views.Economist"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экономист" 
        Height="830" 
        Width="1550"
        WindowState="Maximized"
        Icon="/Assets/Icons/logo.ico"
        FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF0D47A1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1565C0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,3,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF424242"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF5F5F5"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#FFEEEEEE"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFEEEEEE"/>
            <Setter Property="ColumnHeaderHeight" Value="35"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,3,0,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F9FF" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10" Width="1235">
                <StackPanel Width="300" Margin="0,0,20,0">
                    <Label Content="Поиск"/>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <Label x:Name="NameOfCategory" Content="Материалы" FontSize="20" FontWeight="Bold" 
                       VerticalAlignment="Center" Margin="270,0,0,0" HorizontalAlignment="Center" Width="Auto"/>

                <Button x:Name="TypeCategoriesbtn" Content="Переключить на услуги" Width="200" Height="38"
                        Click="TypeCategories_Click" Margin="270,0,0,0"/>
            </StackPanel>

            <Border CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White">
                <DataGrid x:Name="Materials" Visibility="Visible" MouseDoubleClick="Grid_Click"/>
            </Border>
            <Border CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White" >
                <DataGrid x:Name="Services" Visibility="Hidden" MouseDoubleClick="Grid_Click"/>
            </Border>
        </StackPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" 
                Margin="10,10,0,10" Padding="12">
            <StackPanel>
                <TextBlock Text="Управление данными" FontWeight="Bold" Foreground="#FF1976D2" 
                           FontSize="16" Margin="0,0,0,10"/>

                <Label Content="Введите id"/>
                <TextBox x:Name="idBox"/>
                <Label Content="Введите название"/>
                <TextBox x:Name="NameBox"/>

                <StackPanel x:Name="MaterialsInputPanel" Margin="0,5,0,0">
                    <Label Content="Введите кол-во"/>
                    <TextBox x:Name="StockBox"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Введите стоимость" Width="194"/>
                        <Label Content="С НДС/Без" FontSize="12" Width="70"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="PriceBox" Width="198" Margin="0,0,5,0"/>
                        <ComboBox x:Name="PriceChoice" Width="60">
                            <ComboBoxItem Content="Без"/>
                            <ComboBoxItem Content="С НДС"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Label Content="Введите НДС" Width="145"/>
                        <Label Content="%/BYN" FontSize="12" HorizontalAlignment="Center" Width="60"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="NdsBox" Width="198" Margin="0,0,5,0"/>
                        <ComboBox x:Name="NdsChoice" Width="60">
                            <ComboBoxItem Content="%"/>
                            <ComboBoxItem Content="BYN"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="ServicesInputPanel" Margin="0,5,0,0">
                    <Label Content="Введите тариф"/>
                    <TextBox x:Name="TarifBox"/>
                    <Label Content="Введите стоимость доп. материалов"/>
                    <TextBox x:Name="AdditionalMaterialsPriceBox"/>
                </StackPanel>

                <StackPanel Margin="0,15,0,0">
                    <Button Content="Добавить" Click="Add_Click" Height="38"/>
                    <Button Content="Удалить" Click="Delete_Click" Height="38" Margin="0,8,0,0"/>
                    <Button Content="Обновить" Click="Update_Click" Height="38" Margin="0,8,0,0"/>
                    <Button Content="Редактировать" Click="Edit_Click" Height="38" Margin="0,8,0,0"/>
                    <Button Content="Назад" Click="Button_Click" Height="38" Margin="0,15,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>