<Window x:Class="Platezh.Views.Economist"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экономист" 
        Height="830" 
        Width="1550"
        WindowState="Maximized"
        Icon="/Assets/Icons/logo.ico"
        FontSize="14">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#FFF5F9FF" Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,10,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel Width="300" Margin="0,0,20,0">
                    <Label Content="Поиск"/>
                    <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BtnPrices" Content="Цены и склад" Width="140" Click="ViewSwitch_Click"/>
                    <Button x:Name="BtnReference" Content="Справочник материалов" Width="190" Click="ViewSwitch_Click"/>
                    <Button x:Name="BtnServices" Content="Услуги" Width="120" Click="ViewSwitch_Click"/>
                    <Button x:Name="BtnUnits" Content="Единицы измерения" Width="160" Click="ViewSwitch_Click"/>
                </StackPanel>
            </StackPanel>

            <Label Grid.Row="1" x:Name="CurrentTableTitle" Content="Цены и склад" FontSize="20" FontWeight="Bold" Margin="0,5"/>

            <Border Grid.Row="2" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Background="White">
                <DataGrid x:Name="MainGrid" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True" 
                          MouseDoubleClick="Grid_Click">
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="White" CornerRadius="5" BorderBrush="#FFE0E0E0" BorderThickness="1" Margin="10,10,0,10" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Управление данными" FontWeight="Bold" Foreground="#FF1976D2" FontSize="16" Margin="0,0,0,10"/>

                    <StackPanel x:Name="MaterialsInputPanel">
                        <Label Content="Выберите материал:"/>
                        <ComboBox x:Name="MaterialSelectBox" 
                                  DisplayMemberPath="Name" 
                                  SelectedValuePath="MaterialID" 
                                  IsEditable="True"
                                  StaysOpenOnEdit="True"
                                  Margin="0,0,0,5"/>

                        <Label Content="Кол-во материала:"/>
                        <TextBox x:Name="StockBox" Margin="0,0,0,5"/>

                        <Label Content="Стоимость:"/>
                        <TextBox x:Name="PriceBox" Margin="0,0,0,5"/>

                        <Label Content="НДС:"/>
                        <TextBox x:Name="NdsBox" Margin="0,0,0,5"/>

                        <Label Content="Дата с:"/>
                        <DatePicker x:Name="DateFrom" Margin="0,0,0,5"/>

                        <Label Content="Дата по:"/>
                        <DatePicker x:Name="DateTo" Margin="0,0,0,5"/>

                        <CheckBox x:Name="PriceIsActiveCheckBox" Content="Активен" 
                                 IsChecked="True" Margin="0,10,0,10" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="ServicesInputPanel" Visibility="Collapsed">
                        <Label Content="ID тарифа:"/>
                        <TextBox x:Name="TarifIdBox" Margin="0,0,0,5"/>
                        <Label Content="Название:"/>
                        <TextBox x:Name="TarifNameBox" Margin="0,0,0,5"/>
                        <Label Content="Тариф:"/>
                        <TextBox x:Name="TarifBox" Margin="0,0,0,5"/>
                        <Label Content="Стоимость материалов:"/>
                        <TextBox x:Name="AdditionalMaterialsPriceBox" Margin="0,0,0,5"/>
                        <CheckBox x:Name="TarifIsActiveCheckBox" Content="Активен" 
                                 IsChecked="True" Margin="0,10,0,10" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="UnitsInputPanel" Visibility="Collapsed">
                        <Label Content="Ед. измерения:"/>
                        <TextBox x:Name="UnitBox" Margin="0,0,0,5"/>
                    </StackPanel>

                    <StackPanel x:Name="ReferenceInputPanel" Visibility="Collapsed">
                        <Label Content="Название:"/>
                        <TextBox x:Name="UnitNameBox" Margin="0,0,0,5"/>
                        <Label Content="Единица измерения:"/>
                        <ComboBox x:Name="UnitChoice" DisplayMemberPath="Name" SelectedValuePath="UnitID" Margin="0,0,0,5"/>
                        <CheckBox x:Name="IsActiveCheckBox" Content="Активен" 
                                 IsChecked="True" Margin="0,10,0,10" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <Separator Margin="0,15"/>

                    <Button Content="Добавить" Click="Add_Click" Background="#FF43A047" Height="40" FontWeight="Bold"/>
                    <Button Content="Редактировать" Click="Edit_Click" Height="40" FontWeight="Bold"/>
                    <Button Content="Обновить" Click="Update_Click" Height="40" FontWeight="Bold"/>
                    <Button Content="Удалить" Click="Delete_Click" Background="#FFD32F2F" Height="40" FontWeight="Bold"/>

                    <Separator Margin="0,15"/>
                    <Button Content="Назад" Click="Button_Click" Background="#FF757575" Height="35"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>